    "WorkspaceInventoryItem": {
      "title": "WorkspaceInventoryItem",
      "description": "Warehouse material stock record (Kho hàng) tracking remaining quantity, pack size, and low-stock inbox alert threshold.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
