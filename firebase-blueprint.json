    "WorkspaceRevenueEntry": {
      "title": "WorkspaceRevenueEntry",
      "description": "Permanent monthly revenue ledger record split into design revenue (Tiền thiết kế) and print revenue (Tiền in) from successful orders, deletable only proactively by staff.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "description": "Workspace identifier matching the path.",
          "minLength": 67,
          "maxLength": 67,
          "pattern": "^ws_[a-f0-9]{64}$"
        },
        "accountUsername": {
          "type": "string",
          "description": "Registered account usernameKey.",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "invoiceId": {
          "type": "string",
          "description": "Source WorkspaceInvoice ID or empty string for manual revenue entries.",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "invoiceCode": {
          "type": "string",
          "description": "Human-readable invoice reference code or manual code.",
          "minLength": 0,
          "maxLength": 40
        },
        "orderDate": {
          "type": "string",
          "description": "Order date in YYYY-MM-DD format displayed as DD/MM/YYYY.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "monthKey": {
          "type": "string",
          "description": "Reporting month key in YYYY-MM format matching orderDate prefix.",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "customerName": {
          "type": "string",
          "description": "Customer display name for the order.",
          "minLength": 1,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer phone number used to count distinct ordering customers per month.",
          "minLength": 0,
          "maxLength": 30
        },
        "customerCode": {
          "type": "string",
          "description": "Customer code associated with the order.",
          "minLength": 0,
          "maxLength": 30
        },
        "designAmount": {
          "type": "number",
          "description": "Design revenue portion (Tiền thiết kế) in VND."
