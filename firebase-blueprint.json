{
  "entities": {
    "Account": {
      "title": "Account",
      "description": "Account credential record storing normalized usernameKey, display name, and PBKDF2-SHA256 verifierHash (never storing password or workspaceId).",
      "type": "object",
      "properties": {
        "usernameKey": {
          "type": "string",
          "description": "Normalized lowercase account identifier matching the document ID.",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Human-readable display name for the shared account.",
          "minLength": 1,
          "maxLength": 80
        },
        "verifierHash": {
          "type": "string",
          "description": "64-character lowercase hex PBKDF2-HMAC-SHA256 password verification digest.",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account was registered."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account was last updated."
        }
      },
      "required": [
        "usernameKey",
        "displayName",
        "verifierHash",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceInvoice": {
      "title": "WorkspaceInvoice",
      "description": "Saved quotation and landscape invoice scoped to a shared account workspace.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "description": "256-bit capability workspace identifier derived from account username and password.",
          "minLength": 67,
          "maxLength": 67,
          "pattern": "^ws_[a-f0-9]{64}$"
        },
        "accountUsername": {
          "type": "string",
          "description": "Registered account usernameKey owning this workspace.",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "description": "Human-readable invoice reference code.",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "invoiceDate": {
          "type": "string",
          "description": "ISO date-time string displayed as invoice creation date.",
          "minLength": 1,
          "maxLength": 40
        },
        "expectedDemoDate": {
          "type": "string",
          "description": "Expected demo delivery date in YYYY-MM-DD format or empty string.",
          "minLength": 0,
          "maxLength": 20
        },
        "customerName": {
          "type": "string",
          "description": "Customer name on the quotation.",
          "minLength": 0,
          "maxLength": 120
        },
        "customerCode": {
          "type": "string",
          "description": "Customer code generated on save in YYYYMMDDHHmm format.",
          "minLength": 0,
          "maxLength": 30
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer phone number on the quotation.",
          "minLength": 0,
          "maxLength": 30
        },
        "designIllustration": {
          "type": "string",
          "description": "Selected design template illustration style shown above the invoice note.",
          "minLength": 0,
          "maxLength": 200
        },
        "invoiceNote": {
          "type": "string",
          "description": "Custom note shown at the bottom of the landscape invoice.",
          "minLength": 0,
          "maxLength": 3000
        },
        "reportStage": {
          "type": "string",
          "description": "Report pipeline classification stage linked from Saved Quotes (empty string when unclassified).",
          "minLength": 0,
          "maxLength": 30,
          "enum": [
            "",
            "bao_gia",
            "cham_soc",
            "coc",
            "chot_in",
            "chot_thiet_ke",
            "hoan_thanh"
          ]
        },
        "itemSummary": {
          "type": "string",
          "description": "Concise summary of line items for archive listing.",
          "minLength": 1,
          "maxLength": 300
        },
        "itemCount": {
          "type": "number",
          "description": "Number of distinct line item rows in the subcollection."
        },
        "totalQuantity": {
          "type": "number",
          "description": "Sum of quantities across all line items."
        },
        "subtotal": {
          "type": "number",
          "description": "Total order value before discount, shipping, and deposit in VND."
        },
        "discountAmount": {
          "type": "number",
          "description": "Discount amount in VND."
        },
        "shippingFee": {
          "type": "number",
          "description": "Shipping fee in VND."
        },
        "depositAmount": {
          "type": "number",
          "description": "Deposit paid in VND."
        },
        "remainingAmount": {
          "type": "number",
          "description": "Remaining balance payable in VND."
        },
        "remainingPaid": {
          "type": "boolean",
          "description": "True when the remaining balance (stage 2 payment) has been collected."
        },
        "remainingPaidAt": {
          "type": "string",
          "description": "Local YYYY-MM-DD date when the remaining balance was paid or empty string if unpaid.",
          "minLength": 0,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the invoice was first saved."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the invoice was last updated."
        }
      },
      "required": [
        "workspaceId",
        "accountUsername",
        "code",
        "invoiceDate",
        "expectedDemoDate",
        "customerName",
        "customerCode",
        "customerPhone",
        "designIllustration",
        "invoiceNote",
        "itemSummary",
        "itemCount",
        "totalQuantity",
        "subtotal",
        "discountAmount",
        "shippingFee",
        "depositAmount",
        "remainingAmount",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceInvoiceItem": {
      "title": "WorkspaceInvoiceItem",
      "description": "Individual product or design line item belonging to a WorkspaceInvoice.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "description": "Workspace identifier matching the parent WorkspaceInvoice.",
          "minLength": 67,
          "maxLength": 67,
          "pattern": "^ws_[a-f0-9]{64}$"
        },
        "invoiceId": {
          "type": "string",
          "description": "Document ID of the parent WorkspaceInvoice.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "description": "Catalog product ID or empty string for custom items.",
          "minLength": 0,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Product and size description displayed on the invoice row.",
          "minLength": 1,
          "maxLength": 200
        },
        "unit": {
          "type": "string",
          "description": "Unit of measure (e.g., Tờ, Bảng, Mẫu, Lần).",
          "minLength": 1,
          "maxLength": 40
        },
        "quantity": {
          "type": "number",
          "description": "Item quantity (positive integer)."
        },
        "unitPrice": {
          "type": "number",
          "description": "Unit price in VND."
        },
        "note": {
          "type": "string",
          "description": "Multi-line per-item note displayed next to the line total.",
          "minLength": 0,
          "maxLength": 1000
        },
        "sortIndex": {
          "type": "number",
          "description": "Zero-based display order index in the invoice table."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the line item was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the line item was updated."
        }
      },
      "required": [
        "workspaceId",
        "invoiceId",
        "productId",
        "name",
        "unit",
        "quantity",
        "unitPrice",
        "note",
        "sortIndex",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceSettings": {
      "title": "WorkspaceSettings",
      "description": "Shared store profile and default invoice note synchronized across devices logged into the same account.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "description": "Workspace identifier matching the path.",
          "minLength": 67,
          "maxLength": 67,
          "pattern": "^ws_[a-f0-9]{64}$"
        },
        "accountUsername": {
          "type": "string",
          "description": "Registered account usernameKey.",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "description": "Store or company name displayed on invoices.",
          "minLength": 1,
          "maxLength": 120
        },
        "address": {
          "type": "string",
          "description": "Store address displayed on invoices.",
          "minLength": 0,
          "maxLength": 250
        },
        "phone": {
          "type": "string",
          "description": "Store contact phone number.",
          "minLength": 0,
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "description": "Store email or website.",
          "minLength": 0,
          "maxLength": 120
        },
        "tiktok": {
          "type": "string",
          "description": "Store TikTok or social handle.",
          "minLength": 0,
          "maxLength": 80
        },
        "preparerName": {
          "type": "string",
          "description": "Default quote preparer name.",
          "minLength": 0,
          "maxLength": 120
        },
        "invoiceTitle": {
          "type": "string",
          "description": "Centered title on the order/quotation sheet.",
          "minLength": 1,
          "maxLength": 120
        },
        "footerNote": {
          "type": "string",
          "description": "Default general terms and notes for new quotations.",
          "minLength": 0,
          "maxLength": 3000
        },
        "showCalculator": {
          "type": "boolean",
          "description": "Whether the manual bill calculator button is enabled in the workspace."
        },
        "showAiChat": {
          "type": "boolean",
          "description": "Whether the AI chat assistant box is enabled in the workspace."
        },
        "logoVersion": {
          "type": "string",
          "description": "Version token indicating the active company logo uploaded for this workspace (empty string when no logo is set).",
          "minLength": 0,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "signatureVersion": {
          "type": "string",
          "description": "Version token indicating the active preparer signature image uploaded for this workspace (empty string when no signature is set).",
          "minLength": 0,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when settings were initialized."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when settings were last updated."
        }
      },
      "required": [
        "workspaceId",
        "accountUsername",
        "companyName",
        "address",
        "phone",
        "email",
        "tiktok",
        "preparerName",
        "invoiceTitle",
        "footerNote",
        "createdAt",
        "updatedAt"
      ]
    },
