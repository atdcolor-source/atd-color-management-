  "firestore": {
    "/accounts/{usernameKey}": {
      "schema": "Account",
      "description": "Account registry storing usernameKey and PBKDF2 password verifierHash (get/create only; list/update/delete denied)."
    },
    "/workspaces/{workspaceId}/invoices/{invoiceId}": {
      "schema": "WorkspaceInvoice",
      "description": "Saved quotations scoped to a cryptographic workspaceId shared exclusively by holders of the account and password."
    },
    "/workspaces/{workspaceId}/invoices/{invoiceId}/items/{itemId}": {
      "schema": "WorkspaceInvoiceItem",
      "description": "Line items subcollection atomically bound to a parent WorkspaceInvoice."
    },
    "/workspaces/{workspaceId}/settings/{settingId}": {
      "schema": "WorkspaceSettings",
      "description": "Store profile settings shared across devices signed into the same account."
    },
    "/workspaces/{workspaceId}/products/{productId}": {
      "schema": "WorkspaceProduct",
      "description": "Catalog products synchronized across devices signed into the same account."
    },
    "/workspaces/{workspaceId}/voucherBudgets/{monthKey}": {
      "schema": "WorkspaceVoucherBudget",
      "description": "Monthly fixed discount voucher budgets scoped to the shared workspace."
    },
    "/workspaces/{workspaceId}/customers/{customerId}": {
      "schema": "WorkspaceCustomer",
      "description": "Customer contact and date records (Date KH) scoped to the shared workspace."
    },
    "/workspaces/{workspaceId}/inventory/{itemId}": {
      "schema": "WorkspaceInventoryItem",
      "description": "Warehouse stock items (Kho hàng) and restock alert thresholds scoped to the shared workspace."
    },
    "/workspaces/{workspaceId}/revenueEntries/{entryId}": {
      "schema": "WorkspaceRevenueEntry",
      "description": "Permanent monthly revenue records split into design and print revenue, retained forever unless proactively deleted by staff."
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Read-only legacy pre-account invoice archive retained for optional migration."
    },
    "/invoices/{invoiceId}/items/{itemId}": {
      "schema": "InvoiceItem",
      "description": "Read-only legacy line items subcollection."
    }
  }
