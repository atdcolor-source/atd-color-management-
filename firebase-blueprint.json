          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the revenue record was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the revenue record was last updated."
        }
      },
      "required": [
        "workspaceId",
        "accountUsername",
        "invoiceId",
        "invoiceCode",
        "orderDate",
        "monthKey",
        "customerName",
        "customerPhone",
        "customerCode",
        "designAmount",
        "printAmount",
        "totalRevenue",
        "isManualOverride",
        "isDeleted",
        "note",
        "createdAt",
        "updatedAt"
      ]
    },
